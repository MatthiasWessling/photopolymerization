\contentsline {figure}{\numberline {5.1}{\ignorespaces Locked stage ladder. Parked items (Dobson production RHS, NS--gel, inverse DMD, Type~II bleaching, Jacobs as polymer state) remain parked.}}{29}{figure.5.1}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Stage~0 provenance overview (teaching layout of the book, not an experiment).}}{30}{figure.5.2}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Stage~1 local ODE: conversion histories, equal-dose pair, and oxygen induction.}}{31}{figure.5.3}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Stage~2: oxygen--monomer identity and quasi-steady radical residual.}}{32}{figure.5.4}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Stage~3 Gaussian projection (Montgomery Eq.~7 fallback). No conversion is plotted.}}{32}{figure.5.5}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Stage~4: optical front, oxygen wall, and G0$|$G80 strip width.}}{33}{figure.5.6}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Stage~5 plug flow on the Slutzky book: conversion along $x$, $U_c$ trends, pulses.}}{34}{figure.5.7}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Stage~6 Macosko--Miller loops: $P_{\mathrm {gel}}(c)$, $\eta (p)$, and a hypothetical Montgomery trajectory.}}{35}{figure.5.8}%
